{
	"name": "@akcodeworks/svelte-command-form",
	"version": "0.0.0",
	"description": "Command pattern form helper for Svelte powered by Standard Schema validation.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest"
	},
	"homepage": "https://github.com/akcodeworks/svelte-command-form#readme",
	"bugs": {
		"url": "https://github.com/akcodeworks/svelte-command-form/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/akcodeworks/svelte-command-form.git"
	},
	"author": "AK Codeworks",
	"license": "MIT",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/tests/**"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.47.1",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.20.1",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^16.5.0",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^3.5.2",
		"publint": "^0.3.21",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^7.3.6",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.1",
		"zod": "^4.4.3"
	},
	"keywords": [
		"svelte",
		"forms",
		"validation",
		"standard-schema",
		"command"
	],
	"dependencies": {
		"@standard-schema/spec": "^1.1.0"
	}
}